# Copy sang .env, KHÔNG commit
# --- Baidu Netdisk (tải DiffusionForensics) ---
BAIDU_BDUSS=
BAIDU_STOKEN=

# --- Cloudflare R2 (kho nhỏ: checkpoint + manifest sha256) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dire-archive

# --- Hugging Face Hub (mirror công khai chính; token quyền write) ---
# https://huggingface.co/settings/tokens
HF_TOKEN=
HF_REPO_ID=your-user/diffusionforensics-dire

# --- Kaggle (mirror công khai phụ; key từ kaggle.json) ---
# https://www.kaggle.com/settings → Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET_ID=your-user/dire-tier-a

# --- Modal (chỉ cần cho `modal run`; `modal token new` sẽ tự ghi ~/.modal.toml) ---
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
