__pycache__/
*.pyc
.venv/

# Bí mật — KHÔNG BAO GIỜ commit
.env
.env.local
!.env.example
kaggle.json

# Manifest size thật (sinh tự động, thay đổi liên tục) — không commit
manifests/*.tsv
# NHƯNG: manifest sha256 là NGUỒN SỰ THẬT để verify mirror → phải commit (xem ADR-0001)
!manifests/*_sha256.tsv

# Artifact lớn / tạm
.kaggle-staging/
*.log
*.pth
*.pt
platforms/hf-spaces/gallery/*.png
!platforms/hf-spaces/gallery/.gitkeep
.DS_Store

# Dữ liệu tải ở MÁY LOCAL (tools/local_download.sh) — không bao giờ commit
data/

# Figure sinh bởi tools/figures.py — PDF và sidecar JSON thì commit (nhỏ, là nguồn),
# PNG 300 dpi thì không (sinh lại bằng một lệnh).
figs/*.png
figs/**/*.png
*.BaiduPCS-Go-downloading

# Video (tools/manim) — GIF nhỏ thì commit để nhúng README, MP4 thì không
docs/media/_manim/
docs/media/*.mp4
# Panel triplet sinh bởi tools/triplet_view.py — dữ liệu phái sinh từ dataset,
# sinh lại được bằng một lệnh, và không nên commit ảnh của dataset gốc.
docs/media/triplets/

# Build artefact của `pip install -e .` (sinh lại được) — không commit
*.egg-info/
build/
dist/
logs/